*.exe
*.exe~
*.dll
*.so
*.dylib
apps/control-plane/bin/
apps/control-plane/control-plane

# Ralph tui
.ralph-tui
.beads
tasks

# Chronis (local event store data — sync exchange files are tracked)
.chronis/wal/
.chronis/storage/
.chronis/sync/.remote_ids
.chronis/sync/.local_ids
# config.toml carries api_key, and this repository is public. A clone puts the
# working tree on disk, so committing it hands the key to anyone who runs
# `/plugin marketplace add all-source-os/all-source`. The other three fields
# (mode, instance_id, remote_url) are per-machine anyway.
.chronis/config.toml

# Prime MCP local data dir (WAL, Parquet, projection checkpoints)
.prime/

# AI Tools / IDE Assistants
.agent/
.agents/
.cursor/
.gemini/
.github/skills/
.opencode/
.windsurf/

# Claude Code - ignore local/sensitive, keep shared config
.claude/settings.local.json
.claude/projects/
.claude/todos/
.claude/plans/
.claude/statsig/
.claude/credentialCache/
# Per-agent git worktrees created by parallel workflow runs — full checkouts,
# tens of GB. Never commit these.
.claude/worktrees/
.mcp.json

# bv (beads viewer) local config and caches
.bv/

# Elixir (prevent accidental root-level artifacts)
/_build/
/deps/
/mix.lock
# This repo's OWN skills are tracked and were force-added past this rule; see
# `git ls-files .claude/skills`. The rule stays because the directory also holds
# the vendored gstack tree — 797MB of node_modules and prebuilt binaries, which
# does not belong in a public repo's permanent history — plus ~41 SKILL.md
# symlinks into it that would clone as dangling links.
# Adding a new first-party skill therefore needs `git add -f`.
.claude/skills/
.gstack/
.seo-cache/

# npm auth tokens — never commit
.npmrc
.crush-loop/
tooling/crush-loop/target/
