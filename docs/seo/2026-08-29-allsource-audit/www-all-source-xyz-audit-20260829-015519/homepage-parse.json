    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why no free plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There is no permanent free hosted plan. The Apache-2.0 Core and community route can be self-hosted; designated enterprise features use BSL 1.1. Hosted pricing covers operated infrastructure."
          }
        },
        {
          "@type": "Question",
          "name": "What is AllSource?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AllSource Event Store is developer infrastructure for durable event history and AI-agent memory. Core stores ordered application events; Prime derives agent memory; hosted services operate the stack; separate MCP connectors expose event or memory tools."
          }
        },
        {
          "@type": "Question",
          "name": "Is AllSource the same as ArcGIS AllSource?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. AllSource Event Store is the developer product at all-source.xyz and github.com/all-source-os/all-source. ArcGIS AllSource is Esri intelligence-analysis software. The products are unrelated."
          }
        },
        {
          "@type": "Question",
          "name": "How does AllSource compare to traditional databases?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditional databases can preserve history, but teams usually add audit tables, change-data capture, or application logs. AllSource makes immutable event history the primary record, so replay, point-in-time reconstruction, and provenance use the same ordered stream."
          }
        },
        {
          "@type": "Question",
          "name": "What is the MCP Server integration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AllSource has separate MCP connectors. The event-store connector exposes 45 read-only tools, 55 by default, 64 with control-plane access, and 73 with system administration. Prime exposes 19 prime_* memory tools, or 27 with optional inbox and hound modules. Do not add these registries together."
          }
        },
        {
          "@type": "Question",
          "name": "How secure is my data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hosted AllSource separates tenant data and supports JWT authentication, role-based access, policy enforcement, and audit logs. Administrative operations include dry-run previews where the API supports them."
          }
        },
        {
          "@type": "Question",
          "name": "Can I self-host AllSource?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The core is Apache-2.0 licensed, while designated enterprise features use BSL 1.1. Docker images, Helm charts, and Kubernetes manifests are available in the repository; hosted plans operate the services for you."
          }
        },
        {
          "@type": "Question",
          "name": "What is Quant Intelligence?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quant Intelligence is a solution route using AllSource event history and shipped analytics endpoints for bars, correlations, forecasts, and regime summaries. It is not a separate database, a trading model, or a promise of profitable probabilities."
          }
        }
      ]
    }
