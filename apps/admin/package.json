{
  "name": "@allsource/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:real": "playwright test --config=e2e/real/playwright.config.ts",
    "test:e2e:real:headed": "playwright test --config=e2e/real/playwright.config.ts --headed",
    "e2e:stack:up": "docker compose -f e2e/real/docker-compose.e2e.yml up -d --wait",
    "e2e:stack:down": "docker compose -f e2e/real/docker-compose.e2e.yml down -v"
  },
  "dependencies": {
    "@allsource/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@allsource/typescript-config": "workspace:*",
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.14",
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.6",
    "tw-animate-css": "^1.3.5",
    "typescript": "^6.0.2"
  }
}
