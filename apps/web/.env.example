NEXT_PUBLIC_APP_URL=https://www.all-source.xyz
NEXT_PUBLIC_API_URL=http://localhost:3902
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:3901
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3347JLG51K

# Phoenix WebSocket base for the dashboard Live Feed. The browser connects
# DIRECTLY to the Query Service (Vercel can't proxy long-lived sockets), so
# this must be the public QS host with a ws(s):// scheme — NOT the /api proxy.
# NEXT_PUBLIC_* is inlined at build time, so a redeploy is required to change it.
# Local dev: omit it (the hook falls back to the dev server origin).
# Vercel production: NEXT_PUBLIC_WS_URL=wss://allsource-query.fly.dev
NEXT_PUBLIC_WS_URL=

# Server-side only: where Next.js rewrites proxy OAuth requests to.
# On Vercel this must be the public Fly.io URL (no internal network).
# Locally it points to the same localhost control plane.
CONTROL_PLANE_INTERNAL_URL=http://localhost:3901
# Vercel production: CONTROL_PLANE_INTERNAL_URL=https://allsource-control-plane.fly.dev

# Server-side only: persistent, NON-MUTATING credential for the /status page's
# end-to-end login probe (apps/web/src/app/api/status/services/route.ts).
# Set to a long-lived `serviceaccount`-role API key minted for a dedicated
# status-monitor tenant. The probe sends it as a Bearer token to the Query
# Service GET /api/v1/auth/me to prove a real session round-trips.
# If UNSET, the probe degrades to an unauthenticated QS GET /health liveness
# check and marks the end-to-end login signal "unknown" (Degraded) — it NEVER
# mints a token or creates a tenant. (The old probe minted via /api/v1/demo/start,
# which littered /tenants with a Demo User on every cold-start poll — removed.)
# Vercel production (www.all-source.xyz): set STATUS_MONITOR_TOKEN to the key.
STATUS_MONITOR_TOKEN=
