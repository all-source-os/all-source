{
  "name": "read_model_page",
  "description": "readModel(\"skills\").page({prefix: \"skill:\", limit: 100}). The SDK returns rows, checkpoint and content_revision; next null means this is the last page.",
  "request": {
    "method": "GET",
    "path": "/api/v1/read-models/skills",
    "query": { "prefix": "skill:", "limit": "100" },
    "headers": {},
    "body": null
  },
  "response": {
    "status": 200,
    "headers": {},
    "body": {
      "revision": 7,
      "content_revision": 7,
      "checkpoint": { "epoch": 41, "position": 3 },
      "ready": true,
      "unchanged": false,
      "rows": { "skill:abc": { "status": "published" } },
      "next": null
    }
  }
}
