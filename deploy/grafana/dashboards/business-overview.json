      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus_on_fly" }, "legendFormat": "Free memory", "expr": "sum(fly_instance_memory_mem_available{app=\"allsource-core\"})" },
        { "refId": "B", "datasource": { "type": "victoriametrics-logs-datasource", "uid": "application_logs_vlog" }, "editorMode": "code", "queryType": "statsRange", "legendFormat": "Largest tenant needs",
