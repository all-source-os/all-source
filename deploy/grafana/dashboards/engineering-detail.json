      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{tenant}} · {{lane}}",
          "expr": "sort_desc(topk(10, sum by (tenant, lane) (increase(admission_would_refuse_total{tenant=~\"$tenant\"}[$__range])) > 0))"
        }
      ]
    },
    {
      "id": 500,
      "type": "row",
      "title": "5 · Capacity — are we paying for the right machines?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 501,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Shows:** CPU and memory use per app against the machine it runs on, shared-CPU throttling, and machine count. **Healthy:** CPU busy under the app's baseline and memory under 80%. **Act when:** throttling is non-zero (the machine is out of burst credit, so latency rises), memory sits above 85% (the next spike OOM-kills it), or an app idles near 0% on a large machine (a smaller size would cost less)."
      }
    },
    {
      "id": 502,
      "type": "timeseries",
      "title": "CPU busy by app",
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{app}}",
          "expr": "1 - sum by (app) (rate(fly_instance_cpu{app=~\"$app\", mode=\"idle\"}[$__rate_interval])) / sum by (app) (rate(fly_instance_cpu{app=~\"$app\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 503,
      "type": "timeseries",
      "title": "Memory used by app",
      "gridPos": {
        "x": 8,
        "y": 71,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{app}}",
          "expr": "1 - sum by (app) (fly_instance_memory_mem_available{app=~\"$app\"}) / sum by (app) (fly_instance_memory_mem_total{app=~\"$app\"})"
        }
      ]
    },
    {
      "id": 504,
      "type": "timeseries",
      "title": "Shared-CPU throttling by app",
      "description": "Time the machine was held to its shared-CPU baseline because its burst balance ran out. Any non-zero value means requests waited for CPU.",
      "gridPos": {
        "x": 16,
        "y": 71,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{app}}",
          "expr": "sum by (app) (rate(fly_instance_cpu_throttle{app=~\"$app\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 505,
