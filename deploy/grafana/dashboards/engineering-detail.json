        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(fly_edge_data_in{app=~\"$app\", region=~\"$region\"}[$__range]))"
        }
