{
  "uid": "allsource-engineering",
  "title": "AllSource — Engineering Detail",
  "description": "Raw traffic, query shapes, gzip, admission, capacity and Core internals behind the business questions. Source: deploy/grafana/dashboards/engineering-detail.json in all-source-os/all-source.",
  "tags": [
    "allsource",
    "engineering"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "title": "Business questions",
      "type": "link",
      "url": "/d/allsource-business",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Availability & incidents",
      "type": "link",
      "url": "/d/allsource-availability",
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus on Fly",
          "value": "prometheus_on_fly"
        },
        "hide": 2
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(fly_instance_memory_mem_total, app)",
          "refId": "app"
        },
        "definition": "label_values(fly_instance_memory_mem_total, app)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "region",
        "label": "Edge region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(fly_edge_data_out{app=~\"$app\"}, region)",
          "refId": "region"
        },
        "definition": "label_values(fly_edge_data_out{app=~\"$app\"}, region)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "status",
        "label": "HTTP status",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(fly_edge_http_responses_count{app=~\"$app\"}, status)",
          "refId": "status"
        },
        "definition": "label_values(fly_edge_http_responses_count{app=~\"$app\"}, status)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 3
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(control_plane_tenant_requests_total, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(control_plane_tenant_requests_total, tenant)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "selector",
        "label": "Query shape",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(control_plane_tenant_event_queries_total, selector)",
          "refId": "selector"
        },
        "definition": "label_values(control_plane_tenant_event_queries_total, selector)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
