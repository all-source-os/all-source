    {
      "id": 105,
      "type": "stat",
      "title": "Ingress in window",
      "description": "Bytes clients sent to Fly's edge. Fly does not bill inbound traffic; shown for upload-heavy tenants.",
      "gridPos": {
        "x": 18,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
