        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{app}}",
          "expr": "count by (app) (fly_instance_memory_mem_total{app=~\"$app\"})"
        }
      ]
    },
    {
      "id": 600,
      "type": "row",
      "title": "6 · Core workload — what the event store is doing",
