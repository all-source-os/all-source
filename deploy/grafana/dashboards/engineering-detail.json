        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(control_plane_tenant_event_query_body_bytes_total{tenant=~\"$tenant\", selector=~\"$selector\"}[$__range])) / sum(increase(control_plane_tenant_event_queries_total{tenant=~\"$tenant\", selector=~\"$selector\"}[$__range]))"
        }
