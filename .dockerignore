# =============================================================================
# Monorepo Docker Ignore
# Used when building from repository root (e.g., web app)
# =============================================================================

# Dependencies
**/node_modules/

# Build artifacts
**/.next/
**/out/
**/build/
**/dist/
**/target/
**/_build/
**/deps/

# Version control
.git
.gitignore
.gitattributes

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
.cursor/

# Agent tooling. `.claude/worktrees/` holds full checkouts (one per parallel
# agent, each with its own target/ and _build/) and reached 35 GB during a
# single session. Core builds with the repo ROOT as its context, so without
# this every `fly deploy` uploads all of it.
.claude/
.chronis/
proofshot-artifacts/

# Documentation (but keep content for blogs and changelog)
*.md
!README.md
!**/content/**
!docs/CHANGELOG.md

# Test artifacts
**/coverage/
**/.nyc_output/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/test-results/
**/playwright-report/

# Environment files
.env*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local development
**/.turbo/
**/tsconfig.tsbuildinfo
**/*.tsbuildinfo

# Rust specific
**/*.rs.bk

# Elixir specific
**/.elixir_ls/
**/*.beam
**/erl_crash.dump

# Go specific
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# CI/CD and docs
.github/
docs/*
!docs/CHANGELOG.md
deploy/
scripts/

# Tooling - exclude contents but keep Cargo.toml for workspace builds
tooling/**
!tooling/typescript/
!tooling/e2e/package.json
!tooling/performance/Cargo.toml
*.yml
*.yaml
!**/fly.toml
Makefile
biome.json
turbo.json
