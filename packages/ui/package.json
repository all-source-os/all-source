    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "type-check": "tsc --noEmit",
    "test": "bun test --preload ./src/__tests__/setup.ts",
    "clean": "rm -rf .turbo node_modules dist"
